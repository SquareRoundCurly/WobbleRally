{
  "name": "wobble-rally",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "runtime": "node tools/runtime.mjs",
    "build": "python3 tools/scene.py && node tools/build.mjs",
    "dev": "node tools/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tools/browser-tests.mjs",
    "test:inputs": "node tests/browser.mjs",
    "test:race": "node tests/drive.mjs",
    "capture": "node tests/inspect.mjs",
    "record": "node tools/record.mjs",
    "test:package": "node tests/package.mjs",
    "measure": "node tests/performance.mjs",
    "test:device-benchmark": "node tests/device-benchmark-browser.mjs",
    "package": ".venv/bin/python tools/package.py"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0"
  }
}
